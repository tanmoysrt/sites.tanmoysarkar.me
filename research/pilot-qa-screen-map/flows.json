  "findings": [
    {
      "id": "registry-clone-race",
      "severity": "high",
      "title": "First-site dialog shows no apps: concurrent registry clone fails",
      "detail": "On a fresh bench, the first GET /api/v1/marketplace/apps calls arrive together. RegistryCache.ensure_fresh() (pilot/core/registry_cache.py) runs 'git clone' with no lock, so they race on shallow.lock, the failed clones delete the folder, and all return 503 registry_unavailable. Repro: remove system/registry-cache, send 3 parallel requests: 3x 503. useAppRegistry.load() swallows the error and nothing retries, so the dialog hides the app picker without a message.",
      "node": "onboard-site",
      "status": "fixed"
    },
    {
      "id": "step-marker-leak",
      "severity": "low",
      "title": "Raw STEP marker in setup wizard log",
      "detail": "Setup log shows 'STEP init,1794485147.982 Initialize bench', which is the internal progress protocol line.",
      "node": "setup-progress",
      "status": "open"
    },
    {
      "id": "checklist-early",
      "severity": "low",
      "title": "Checklist marks first site done while task runs",
      "detail": "Get started shows 'Create your first site' ticked while the New Site task is still running.",
      "node": "site-create-task",
      "status": "open"
    },
    {
      "id": "network-parallel",
      "severity": "info",
      "title": "Direct :7000 dev server drops parallel loads from remote network (not Pilot)",
      "detail": "Blank page over http://IP:7000 because some of 50 parallel asset requests time out from this client network. From inside the VM 50/50 succeed. Over nginx HTTP/2 all succeed. Network path issue, not a Pilot bug.",
      "node": "setup-database",
      "status": "info"
    },
    {
      "id": "locks-no-blocker",
      "severity": "medium",
      "title": "Locks tab hides the blocking transaction",
      "detail": "MariaDBEngine.get_lock_wait_rows() (pilot/core/database/engines/mariadb.py) selects only requesting_trx_id. blocking_trx_id and its thread id are not joined, so the operator sees the victim but not the connection to kill. Repro: session A SELECT ... FOR UPDATE + sleep; session B UPDATE same row: only B is listed.",
      "node": "dba-locks",
      "status": "fixed"
    },
    {
      "id": "locks-started-tz",
      "severity": "low",
      "title": "Lock 'Started' shows raw server time without zone",
      "detail": "trx_started is str(datetime) in server time (UTC here) while the rest of the UI shows browser local time.",
      "node": "dba-locks",
      "status": "open"
    },
    {
      "id": "deadlocks-missing",
      "severity": "high",
      "title": "No Deadlocks view; MariaDB error log is only in journald",
      "detail": "innodb_print_all_deadlocks=ON is set, but log_error is empty, so mariadbd writes to stderr and journald (pilot-mariadb.service). Pilot cannot scan it as a file, and the analyzer has no deadlock view. The 'error log' size readout (mariadb.py _variable_file_size(@@log_error)) reads an empty path. Repro: two transactions updating rows 1,2 in opposite order: ERROR 1213, and only journalctl shows the dump.",
      "node": "dba-locks",
      "status": "fixed"
    },
    {
      "id": "binlog-off-state",
      "severity": "low",
      "title": "Binlog off looks like 'no files' with a green status dot",
      "detail": "get_binlog_files() returns [] when log_bin=0, so the tab says 'The server has no binary log files' and the side panel shows a green dot with '0 files'. It should say binary logging is off.",
      "node": "dba-binlogs-off",
      "status": "fixed"
    },
    {
      "id": "duplicate-columns",
      "severity": "high",
      "title": "MariaDB queries drop repeated column names",
      "detail": "execute() built rows from a dict cursor by column name, so 'SELECT a.name, b.name' showed a.name twice (SQL console, lock wait blocker). Fixed: tuple cursor.",
      "node": "dba-locks-blocker",
      "status": "fixed"
    },
    {
      "id": "failed-install-marker",
      "severity": "high",
      "title": "Failed after_install leaves app listed as installed",
      "detail": "Frappe adds the app before after_install; a failure left it listed and a retry failed on duplicate Module Defs. Fixed: Pilot marks it 'Install incomplete' with a forced Retry.",
      "node": "install-incomplete",
      "status": "fixed"
    },
    {
      "id": "slow-log-never-on",
      "severity": "high",
      "title": "Slow query monitoring never collected anything",
      "detail": "Nothing enabled the MariaDB slow log and the collector required log_output=TABLE, so slow query charts were always empty. Fixed: my.cnf writes a slow log file; analyzer and monitor read it.",
      "node": "dba-slow-queries",
      "status": "fixed"
    },
    {
      "id": "sql-console-columns",
      "severity": "high",
      "title": "SQL console showed the wrong column for repeated names",
      "detail": "The result table keyed cells by column name, so 'SELECT u.name, r.name' showed r.name twice. Fixed: cells keyed by position.",
      "node": "console-sql",
      "status": "fixed"
    },
    {
      "id": "unknown-route-blank",
      "severity": "low",
      "title": "Unknown URL renders an empty page",
      "detail": "No catch-all route. Fixed: redirect home.",
      "node": "updates",
      "status": "fixed"
    },
    {
      "id": "swap-tile-hidden",
      "severity": "low",
      "title": "Swap tile hidden at 0 GB",
      "detail": "System info hid swap when 0. Fixed: shows 0 GB.",
      "node": "settings-bench",
      "status": "fixed"
    },
    {
      "id": "error-log-red",
      "severity": "low",
      "title": "stderr INFO logs flagged as errors",
      "detail": "gunicorn/uvicorn write INFO to stderr, so *.error.log files get a red marker in Logs.",
      "node": "logs",
      "status": "open"
    },
    {
      "id": "search-no-sites",
      "severity": "low",
      "title": "Search palette does not find sites",
      "detail": "Ctrl+K searches pages, actions and settings only; typing a site name gives no results.",
      "node": "search",
      "status": "open"
    }
